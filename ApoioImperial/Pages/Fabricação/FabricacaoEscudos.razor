@page "/Fabricacao/Escudos"
@using ImperialInfo.Services
@using ImperialInfo.Tipos
@using ImperialInfo.Tipos.Fabricação
@using ImperialInfo.Tipos.Receitas
@using ApoioImperial.Shared
@inject FabricadorService FabricadorService

<PageTitle>Fabricação de Escudos</PageTitle>

<h3>Fabricação de Escudos</h3>

<FormularioFabricacaoEscudo OnContextoGerado="HandleContextoGerado" />

@if (_resultado is not null)
{
    <hr />
    <ExpositorEscudo resultado="_resultado" />
}

@code {
    private ResultadoFabricacao<Escudo>? _resultado;

    private void HandleContextoGerado(ContextoFabricação<ReceitaEscudo> contexto)
    {
        _resultado = FabricadorService.FabricarEscudo(contexto);
    }
}
